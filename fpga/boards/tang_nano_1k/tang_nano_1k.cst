// Tang Nano 1K 板级引脚约束。
// 引脚号来自本机实板项目，I/O 标准以 Sipeed 官方 1K 示例为准。
IO_LOC  "led[2]" 11;
IO_PORT "led[2]" DRIVE=8 IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[1]" 10;
IO_PORT "led[1]" DRIVE=8 IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[0]" 9;
IO_PORT "led[0]" DRIVE=8 IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "sys_clk" 47;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// BTN1：用户输入，低电平表示按下。
IO_LOC  "btn1" 13;
IO_PORT "btn1" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// BTN2：复位输入，低电平表示按下。
IO_LOC  "btn2" 44;
IO_PORT "btn2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
